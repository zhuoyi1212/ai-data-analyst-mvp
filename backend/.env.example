# LLM 配置（OpenAI 兼容接口；默认 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 固件模式：
#   replay  = 离线回放录制固件（默认，无需 key、不联网）
#   live    = 真实调用 LLM
#   record  = 真实调用并录制固件
LLM_FIXTURE_MODE=replay

# 浏览器直连后端时允许的 CORS 来源（逗号分隔）。
# 留空则使用本地默认（localhost:3000/3100）。*.vercel.app 已由正则自动放行。
# 部署示例：CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ORIGINS=
